# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and not converted to native line endings on checkout
*.go text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Makefile text eol=lf
LICENSE text eol=lf

# Binary files
*.iso binary
*.bin binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.tar.gz binary
